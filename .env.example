# Opcional: envio direto do formulário de Contato por e-mail (web3forms.com). Sem a chave, só "Abrir no meu e-mail" e "Copiar".
VITE_WEB3FORMS_KEY=your_access_key_here

# Opcional: Vercel Web Analytics e Speed Insights (somente Production).
VITE_ENABLE_PROD_ANALYTICS=false

# Contador de visitas e avaliações. A integração Upstash da Vercel cria estas variáveis.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token
# Alternativa com banco criado direto na Upstash:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Recomendado: segredo do hash anônimo dos visitantes (HMAC-SHA256 do IP), com 32+ caracteres aleatórios.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ele, a API usa o token do Redis como segredo (também só existe no servidor).
# COUNTER_SALT=
