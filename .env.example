# Opcional: envia as sugestões do modal de feedback por e-mail (web3forms.com).
VITE_WEB3FORMS_KEY=your_access_key_here

# Opcional: Vercel Web Analytics e Speed Insights (somente Production).
VITE_ENABLE_PROD_ANALYTICS=false

# Contador de visitas e avaliações. A integração Upstash da Vercel cria estas variáveis.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token
# Alternativa com banco criado direto na Upstash:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opcional: sal do hash anônimo dos visitantes.
# COUNTER_SALT=
